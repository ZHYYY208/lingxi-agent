# ---------------------------------------------------------------------------
# Lingxi configuration (Spring Boot)
# Copy to .env only if you need local overrides. All values have defaults.
# Spring Boot imports this file as properties when started from the project root.
# ---------------------------------------------------------------------------

# Web
PORT=8000
MAX_UPLOAD_MB=25
APP_ENV=development

# Optional API key. When set, every /api request needs X-API-Key or Bearer.
LINGXI_API_KEY=

# Admin console (/admin). Change these before exposing the service publicly.
ADMIN_PASSWORD=lingxi-admin
ADMIN_TOKEN_TTL_SECONDS=28800
LINGXI_SECRET=lingxi-local-secret-change-me

# LLM (OpenAI Chat Completions compatible). Leave key empty for local evidence mode.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_SECONDS=60

# Web search is off by default. Set true to expose the tool.
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

# Embedded demo database. Replace with a MySQL JDBC URL when needed.
DATA_DIR=./data
DATABASE_URL=jdbc:h2:file:./data/lingxi;MODE=MySQL;DATABASE_TO_LOWER=TRUE;CASE_INSENSITIVE_IDENTIFIERS=TRUE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Optional Redis session cache.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SESSION_CACHE_TTL_SECONDS=86400

# Optional Milvus vector store. Leave blank for the local vector index.
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=lingxi_chunks

# RAG tuning
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=24
MIN_RETRIEVAL_SCORE=0.12
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Demo
ENABLE_DEMO_SEED=true
DEMO_STREAM_DELAY_MS=14

# Security / observability
RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=20
# Comma-separated origins, only needed when the frontend is on another domain.
# CORS_ORIGINS=https://lingxi.example.com

# Docker Compose secrets
MYSQL_ROOT_PASSWORD=lingxi_root_pass
MYSQL_PASSWORD=lingxi_pass
MYSQL_PORT=3306
API_PORT=8000
MINIO_CONSOLE_PORT=9001
MILVUS_PORT=19530
